# The Adaptive Game -- npm config (compatible con npm 11.x en Node 24/26)
#
# engine-strict queda DESACTIVADO durante la transicion a Node 26 (este
# entorno corre Node 24.12.0). Reactivar cuando TODO el entorno este en Node 26:
#
# engine-strict=true

# Resolucion y caches
legacy-peer-deps=false
save-exact=false
package-lock=true
fund=false
audit=false

# Las opciones especificas de pnpm (node-linker, prefer-frozen-lockfile,
# public-hoist-pattern, use-node-version, resolution-mode, etc.) viven en
# pnpm-workspace.yaml y se ignoran aqui.