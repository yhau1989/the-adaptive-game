engine-strict=true
# engine-strict=true

# Resolucion y caches
legacy-peer-deps=false
save-exact=false
package-lock=true
fund=false
audit=false

# Las opciones especificas de pnpm (node-linker, prefer-frozen-lockfile,
# public-hoist-pattern, use-node-version, resolution-mode, etc.) viven en
# pnpm-workspace.yaml y se ignoran aqui.